# OpenAI — used only by transcribe.py (server-side pipeline), never shipped to the client.
OPENAI_API_KEY=

# Supabase — cross-device sync. The app works fully WITHOUT these (anonymous,
# localStorage-only); they only enable optional "sign in to sync".
# Both are public (anon key is safe to expose); find them in
# Supabase dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role — SERVER/CLI ONLY, never NEXT_PUBLIC_, never in the
# browser. It bypasses every RLS policy in the database. Used by the discovery
# harvest (scripts/harvest-youtube.mts) to write loro_video_candidates, which
# has RLS on with no policies and is unreachable any other way.
# Supabase dashboard → Project Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=

# YouTube Data API v3 key, for the discovery harvest. Metadata only — the
# pipeline never downloads video. Google Cloud console → APIs & Services →
# Credentials, with "YouTube Data API v3" enabled on the project.
# Default quota is 10,000 units/day; one search.list costs 100.
YOUTUBE_API_KEY=

# Secret for the private /waitlist dashboard, passed as ?key=... Server-only
# (never NEXT_PUBLIC_) — it is compared in a server component and never reaches
# the browser. Unset means the route 404s, which is the safe default: the
# dashboard should disappear if the var goes missing, not open.
# Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
WAITLIST_DASHBOARD_KEY=

# Dedicated admin-dashboard account, used by scripts/dashboard-account.mts to
# create (or rotate) a Supabase user that exists only to open /admin/*.
#
# NEVER NEXT_PUBLIC_, and never read by the app: the browser signs in through
# the ordinary Supabase password form, so these are a CLI input and a written
# record of the credentials, not a runtime secret the deployment needs. If a
# future change makes the page read the password directly, it must go through
# a server component or route handler — a NEXT_PUBLIC_ password would publish
# admin access to the analytics of everyone who has ever opened the app.
#
# Why this account exists at all: /admin/* is gated by loro_is_admin() against
# auth.uid(), so only a real session opens it, and the human admin accounts
# sign in through OAuth — which lands the session on whatever origin Supabase
# redirects to, and silently on the wrong one when an origin is missing from
# the Redirect URLs allowlist. A password session cannot be misrouted.
#
# Creating it needs SUPABASE_SERVICE_ROLE_KEY (mailer_autoconfirm is off, so a
# plain signup would sit unconfirmed) — the CLI's, not the deployment's.
ADMIN_DASHBOARD_EMAIL=
ADMIN_DASHBOARD_PASSWORD=
