{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["esnext"],
    "strict": true,
    "noEmit": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    // Same rationale as the root config: these modules run straight through
    // Node's built-in type stripping (`node --test`), which needs real,
    // extension-ed import specifiers. Safe because this config never emits.
    "allowImportingTsExtensions": true
  },
  "include": ["src/**/*.ts", "src/**/*.mts"]
}
