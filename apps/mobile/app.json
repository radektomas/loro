{
  "expo": {
    "name": "Loro",
    "slug": "radektomas",
    "version": "1.0.0",
    "icon": "./assets/icon.png",
    "scheme": "loro",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0a0d0b",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.getloro",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "extra": {
      "eas": {
        "projectId": "b91fb9e8-66c2-453e-91a5-4dbc71ec571b"
      }
    },
    "owner": "radektomass-team",
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/loro-logo.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#0a0d0b"
        }
      ],
      "expo-web-browser"
    ]
  }
}
